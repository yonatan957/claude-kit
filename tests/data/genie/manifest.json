{
  "manifest_version": 1,
  "entries": [
    {
      "kind": "mcp",
      "name": "gitlab",
      "version": "1.2.0",
      "description": "Internal GitLab MCP",
      "inputs": [
        { "key": "GITLAB_TOKEN", "description": "Personal access token",
          "help": "GitLab -> Preferences -> Access Tokens, scope: api",
          "secret": true, "required": true },
        { "key": "GITLAB_URL", "description": "GitLab base URL",
          "default": "https://gitlab.internal" }
      ],
      "mcp": {
        "type": "http",
        "url": "{GITLAB_URL}/mcp",
        "headers": { "Authorization": "Bearer {GITLAB_TOKEN}" }
      }
    },
    {
      "kind": "mcp",
      "name": "k8s",
      "version": "2.0.1",
      "description": "Kubernetes MCP (local binary)",
      "inputs": [ { "key": "KUBECONFIG", "description": "Path to kubeconfig", "required": true } ],
      "install": {
        "windows": "scripts/k8s/install.ps1",
        "linux": "scripts/k8s/install.sh",
        "macos": "scripts/k8s/install.sh"
      },
      "uninstall": {
        "windows": "scripts/k8s/uninstall.ps1",
        "linux": "scripts/k8s/uninstall.sh",
        "macos": "scripts/k8s/uninstall.sh"
      },
      "mcp": {
        "type": "stdio",
        "command": "{KIT_HOME}/tools/k8s-mcp/k8s-mcp",
        "env": { "KUBECONFIG": "{KUBECONFIG}" }
      }
    },
    {
      "kind": "tool",
      "name": "kubectl",
      "version": "1.31.2",
      "description": "Kubernetes CLI",
      "install": {
        "windows": "scripts/kubectl/install.ps1",
        "linux": "scripts/kubectl/install.sh",
        "macos": "scripts/kubectl/install.sh"
      },
      "uninstall": {
        "windows": "scripts/kubectl/uninstall.ps1",
        "linux": "scripts/kubectl/uninstall.sh",
        "macos": "scripts/kubectl/uninstall.sh"
      }
    }
  ]
}
