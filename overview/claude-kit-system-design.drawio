yle="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n6"><mxGeometry x="15" y="427" width="230" height="40" as="geometry"/></mxCell><mxCell id="n15" value="core/ — PURE FUNCTIONS, no prints/prompts" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n5"><mxGeometry x="300" y="40" width="260" height="500" as="geometry"/></mxCell><mxCell id="n16" value="catalog.py&lt;br&gt;clone / pull / validate registry&lt;br&gt;+ min_cli_version gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="35" width="230" height="48" as="geometry"/></mxCell><mxCell id="n17" value="state.py&lt;br&gt;read-write installed.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="92" width="230" height="48" as="geometry"/></mxCell><mxCell id="n18" value="sync.py&lt;br&gt;diff engine → action plan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="149" width="230" height="48" as="geometry"/></mxCell><mxCell id="n19" value="configure.py&lt;br&gt;pending / submit(answers) / verify" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="206" width="230" height="48" as="geometry"/></mxCell><mxCell id="n20" value="search.py&lt;br&gt;query skill_sources (clawhub...)&lt;br&gt;returns results — skills now, more later" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="263" width="230" height="48" as="geometry"/></mxCell><mxCell id="n21" value="logging.py&lt;br&gt;structured log of every action + error" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="320" width="230" height="48" as="geometry"/></mxCell><mxCell id="n22" value="bootstrap.py&lt;br&gt;Claude Code check · paths" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="377" width="230" height="48" as="geometry"/></mxCell><mxCell id="n112" value="notice.py&lt;br&gt;notice(state, registry) -&gt; Notice&lt;br&gt;catalog behind? newer CLI? newer&lt;br&gt;Claude Code? pending config?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="n15"><mxGeometry x="15" y="434" width="230" height="55" as="geometry"/></mxCell><mxCell id="n23" value="installers/ — runs component scripts" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n5"><mxGeometry x="20" y="560" width="260" height="300" as="geometry"/></mxCell><mxCell id="n24" value="base.py — ONE generic loop for every type&lt;br&gt;install / config / verify / uninstall&lt;br&gt;dispatches by types[].handler" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n23"><mxGeometry x="15" y="35" width="230" height="44" as="geometry"/></mxCell><mxCell id="n25" value="content.py — handler: &quot;content&quot;&lt;br&gt;&lt;b&gt;skills + agents&lt;/b&gt;: copy files from&lt;br&gt;catalog into ~/.claude/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n23"><mxGeometry x="15" y="87" width="230" height="44" as="geometry"/></mxCell><mxCell id="n26" value="scripts.py — handler: &quot;script&quot;&lt;br&gt;&lt;b&gt;tools + mcps&lt;/b&gt;: run the .sh lifecycle,&lt;br&gt;inject mcp_config for mcps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n23"><mxGeometry x="15" y="139" width="230" height="44" as="geometry"/></mxCell><mxCell id="n27" value="marketplace.py — handler: &quot;marketplace&quot;&lt;br&gt;&lt;b&gt;plugins&lt;/b&gt;: claude plugin install /&lt;br&gt;uninstall @base-kit --scope user" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n23"><mxGeometry x="15" y="191" width="230" height="44" as="geometry"/></mxCell><mxCell id="n28" value="[+ ADD NEW HANDLER]&lt;br&gt;a new TYPE needs no code —&lt;br&gt;only a registry types[] entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n23"><mxGeometry x="15" y="243" width="230" height="44" as="geometry"/></mxCell><mxCell id="n29" value="ui/ — frontends (render core results)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n5"><mxGeometry x="300" y="560" width="260" height="230" as="geometry"/></mxCell><mxCell id="n30" value="tui.py&lt;br&gt;select + configure + skill search&lt;br&gt;inputs collected here (masked)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n29"><mxGeometry x="15" y="35" width="230" height="52" as="geometry"/></mxCell><mxCell id="n31" value="output.py&lt;br&gt;rich tables and spinners" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n29"><mxGeometry x="15" y="100" width="230" height="46" as="geometry"/></mxCell><mxCell id="n32" value="[+ web/ — future Flask UI]&lt;br&gt;localhost wizard, same core API" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n29"><mxGeometry x="15" y="160" width="230" height="46" as="geometry"/></mxCell><mxCell id="n33" value="Catalog Repo — base-kit-catalog (Git remote, source of truth)  ·  also the 'base-kit' plugin marketplace" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="830" height="540" as="geometry"/></mxCell><mxCell id="n34" value="registry.json — master index&lt;br&gt;&lt;b&gt;types[]&lt;/b&gt; declares the categories → skills · agents · plugins · tools · mcps&lt;br&gt;curated entries per type · plugin_marketplace · skill_sources[] (optional) · min_cli_version" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n33"><mxGeometry x="20" y="40" width="790" height="65" as="geometry"/></mxCell><mxCell id="n35" value="content types — files we own and copy as-is" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n33"><mxGeometry x="20" y="125" width="250" height="190" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;skills/&lt;name&gt;/SKILL.md&lt;/b&gt;&lt;br&gt;our blessed skill content — lives here,&lt;br&gt;so we don't depend on any hub" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n35"><mxGeometry x="15" y="35" width="220" height="55" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;agents/&lt;name&gt;.md&lt;/b&gt;&lt;br&gt;blessed agent personas —&lt;br&gt;same handling as skills" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n35"><mxGeometry x="15" y="100" width="220" height="55" as="geometry"/></mxCell><mxCell id="n38" value="[+ ADD NEW SKILL / AGENT]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n35"><mxGeometry x="15" y="163" width="220" height="24" as="geometry"/></mxCell><mxCell id="n100" value="plugins — bundles, vendored in-repo" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n33"><mxGeometry x="560" y="125" width="250" height="280" as="geometry"/></mxCell><mxCell id="n101" value="&lt;b&gt;.claude-plugin/marketplace.json&lt;/b&gt;&lt;br&gt;the catalog Claude Code reads:&lt;br&gt;name · version · source per plugin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n100"><mxGeometry x="15" y="35" width="220" height="55" as="geometry"/></mxCell><mxCell id="n102" value="&lt;b&gt;plugins/&lt;name&gt;/&lt;/b&gt;&lt;br&gt;vendored content: hooks · agents ·&lt;br&gt;.mcp.json · .lsp.json  (relative source&lt;br&gt;= no external fetch at install)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n100"><mxGeometry x="15" y="100" width="220" height="55" as="geometry"/></mxCell><mxCell id="n114" value="&lt;b&gt;plugins/claude-kit-notify/&lt;/b&gt;&lt;br&gt;hooks/hooks.json — SessionStart:&lt;br&gt;reads state.json → systemMessage,&lt;br&gt;then spawns 'claude-kit check' detached" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n100"><mxGeometry x="15" y="165" width="220" height="65" as="geometry"/></mxCell><mxCell id="n103" value="[+ ADD NEW PLUGIN]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n100"><mxGeometry x="15" y="240" width="220" height="24" as="geometry"/></mxCell><mxCell id="n39" value="scripts/&lt;type&gt;/&lt;name&gt;/ — one folder per component" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n33"><mxGeometry x="290" y="125" width="250" height="190" as="geometry"/></mxCell><mxCell id="n40" value="tools/gitlab-cli/&lt;br&gt;install.sh · config.sh&lt;br&gt;verify.sh · uninstall.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n39"><mxGeometry x="15" y="35" width="220" height="44" as="geometry"/></mxCell><mxCell id="n41" value="mcps/jira-internal/&lt;br&gt;install.sh · config.sh&lt;br&gt;verify.sh · uninstall.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n39"><mxGeometry x="15" y="88" width="220" height="44" as="geometry"/></mxCell><mxCell id="n42" value="[+ ADD NEW COMPONENT SCRIPTS]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n39"><mxGeometry x="15" y="140" width="220" height="32" as="geometry"/></mxCell><mxCell id="n43" value="mcp_config blocks (inside registry.json)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;container=1;collapsible=0;" vertex="1" parent="n33"><mxGeometry x="20" y="335" width="250" height="145" as="geometry"/></mxCell><mxCell id="n44" value="jira-internal&lt;br&gt;command + args + env_file" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="n43"><mxGeometry x="15" y="35" width="220" height="44" as="geometry"/></mxCell><mxCell id="n45" value="[+ ADD NEW MCP SERVER]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;fontColor=#666666;" vertex="1" parent="n43"><mxGeometry x="15" 