  "_comment_files": "Every 'files' map is keyed by repo-relative path. Hashes are computed by CI on every MR — never written by hand. The CLI compares them against the file on disk and against installed.json to tell 'outdated' apart from 'locally modified'.",

  "types": [
    { "name": "skills",  "handler": "content",     "catalog_dir": "skills/",  "target": "~/.claude/skills/" },
    { "name": "agents",  "handler": "content",     "catalog_dir": "agents/",  "target": "~/.claude/agents/" },
    { "name": "plugins", "handler": "marketplace", "marketplace": "base-kit" },
    { "name": "tools",   "handler": "script" },
    { "name": "mcps",    "handler": "script",      "inject": "mcpServers" }
  ],

  "plugin_marketplace": {
    "name": "base-kit",
    "path": ".",
    "commands": {
      "add": "claude plugin marketplace add {path}",
      "install": "claude plugin install {id}@base-kit --scope user",
      "uninstall": "claude plugin uninstall {id}@base-kit",
      "update": "claude plugin marketplace update base-kit"
    }
  },

  "skill_sources": [
